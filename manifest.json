{
  "manifest_version": 3,
  "name": "Waitwell Custom Layout",
  "version": "1.0",
  "description": "Custom UI modifications for the Waitwell dashboard.",
  "content_scripts": [
    {
      "matches": ["https://*.waitwell.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
